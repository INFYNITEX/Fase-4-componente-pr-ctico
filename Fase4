class Asesoria(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 1 <= duracion <= 8:
            raise ErrorValidacion("La asesoría debe durar de 1 a 8 horas.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_duracion(duracion)
        return self.calcular_total(duracion, impuesto, descuento)

    def describir(self):
        return f"Asesoría: {self.nombre} | Tarifa por hora: ${self.tarifa:,.2f}"




