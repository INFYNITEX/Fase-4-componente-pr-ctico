# Herramientas para crear las clases y guardar los errores.
from abc import ABC, abstractmethod
import logging


# Aquí se guardan los eventos y errores del programa.
logging.basicConfig(
    filename="software_fj.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    encoding="utf-8"
)


# Errores que puede presentar el sistema.
class ErrorSistema(Exception):
    pass


class ErrorValidacion(ErrorSistema):
    pass


class ErrorServicio(ErrorSistema):
    pass


class ErrorReserva(ErrorSistema):
    pass


# Clase base para los elementos del sistema.
class Entidad(ABC):
    def __init__(self, identificador):
        if not identificador or not str(identificador).strip():
            raise ErrorValidacion("El identificador es obligatorio.")
        self._identificador = str(identificador).strip()

    @property
    def identificador(self):
        return self._identificador

    @abstractmethod
    def describir(self):
        pass


# Datos del cliente y sus validaciones.
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        self.nombre = nombre
        self.correo = correo
        self.telefono = telefono

    @property
    def nombre(self):
        return self._nombre

    @nombre.setter
    def nombre(self, valor):
        if not isinstance(valor, str) or len(valor.strip()) < 2:
            raise ErrorValidacion("El nombre debe tener al menos 2 caracteres.")
        self._nombre = valor.strip()

    @property
    def correo(self):
        return self._correo

    @correo.setter
    def correo(self, valor):
        if not isinstance(valor, str) or "@" not in valor or "." not in valor:
            raise ErrorValidacion("El correo no es válido.")
        self._correo = valor.strip()

    @property
    def telefono(self):
        return self._telefono

    @telefono.setter
    def telefono(self, valor):
        texto = str(valor).replace(" ", "").replace("+", "").replace("-", "")
        if not texto.isdigit() or len(texto) < 7 or len(texto) > 15:
            raise ErrorValidacion("El teléfono debe tener entre 7 y 15 dígitos.")
        self._telefono = str(valor).strip()

    def describir(self):
        return f"{self.identificador} | {self.nombre} | {self.correo} | {self.telefono}"

# Clase base para los servicios.
class Servicio(Entidad, ABC):
    def __init__(self, identificador, nombre, tarifa, disponible=True):
        super().__init__(identificador)
        if not nombre or not str(nombre).strip():
            raise ErrorValidacion("El nombre del servicio es obligatorio.")
        if not isinstance(tarifa, (int, float)) or isinstance(tarifa, bool) or tarifa <= 0:
            raise ErrorValidacion("La tarifa debe ser mayor que cero.")
        self.nombre = str(nombre).strip()
        self.tarifa = float(tarifa)
        self.disponible = disponible

    def revisar_disponibilidad(self):
        if not self.disponible:
            raise ErrorServicio("El servicio no está disponible.")

    def calcular_total(self, duracion, impuesto=0, descuento=0):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:
            raise ErrorValidacion("La duración debe ser mayor que cero.")
        if not 0 <= impuesto <= 100:
            raise ErrorValidacion("El impuesto debe estar entre 0 y 100.")
        if not 0 <= descuento <= 100:
            raise ErrorValidacion("El descuento debe estar entre 0 y 100.")

        total = self.tarifa * duracion
        total = total + (total * impuesto / 100)
        total = total - (total * descuento / 100)
        return round(total, 2)

    @abstractmethod
    def validar_duracion(self, duracion):
        pass

    @abstractmethod
    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        pass

    @abstractmethod
    def describir(self):
        pass


# Tipos de servicio que ofrece la empresa.
class ReservaSala(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 0 < duracion <= 12:
            raise ErrorValidacion("La sala se reserva por un máximo de 12 horas.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_duracion(duracion)
        return self.calcular_total(duracion, impuesto, descuento)

    def describir(self):
        return f"Sala: {self.nombre} | Tarifa por hora: ${self.tarifa:,.2f}"


class AlquilerEquipo(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 0 < duracion <= 30:
            raise ErrorValidacion("El alquiler debe ser de máximo 30 días.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_duracion(duracion)
        return self.calcular_total(duracion, impuesto, descuento)

    def describir(self):
        return f"Equipo: {self.nombre} | Tarifa por día: ${self.tarifa:,.2f}"


class Asesoria(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 1 <= duracion <= 8:
            raise ErrorValidacion("La asesoría debe durar de 1 a 8 horas.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_duracion(duracion)
        return self.calcular_total(duracion, impuesto, descuento)

    def describir(self):
        return f"Asesoría: {self.nombre} | Tarifa por hora: ${self.tarifa:,.2f}"


# Datos y operaciones de cada reserva.
class Reserva(Entidad):
    def __init__(self, identificador, cliente, servicio, duracion,
                 impuesto=0, descuento=0):
        super().__init__(identificador)
        if not isinstance(cliente, Cliente):
            raise ErrorValidacion("Debe seleccionar un cliente válido.")
        if not isinstance(servicio, Servicio):
            raise ErrorValidacion("Debe seleccionar un servicio válido.")

        servicio.revisar_disponibilidad()
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.costo = servicio.calcular_costo(duracion, impuesto, descuento)
        self.estado = "Pendiente"

    def confirmar(self):
        if self.estado != "Pendiente":
            raise ErrorReserva("Solo se pueden confirmar reservas pendientes.")
        self.servicio.revisar_disponibilidad()
        self.estado = "Confirmada"
        logging.info("Reserva confirmada: %s", self.identificador)

    def cancelar(self):
        if self.estado == "Cancelada":
            raise ErrorReserva("La reserva ya está cancelada.")
        self.estado = "Cancelada"
        logging.info("Reserva cancelada: %s", self.identificador)

    def procesar(self):
        # Si ocurre un error, se registra y se informa sin perder la causa.
        try:
            self.confirmar()
        except ErrorSistema as error:
            logging.exception("No se pudo procesar la reserva.")
            raise ErrorReserva("No se pudo procesar la reserva.") from error
        else:
            logging.info("Reserva procesada: %s", self.identificador)
            return f"Reserva confirmada. Total: ${self.costo:,.2f}"
        finally:
            logging.info("Terminó el proceso de la reserva: %s", self.identificador)

    def describir(self):
        return (
            f"{self.identificador} | Cliente: {self.cliente.nombre} | "
            f"Servicio: {self.servicio.nombre} | Duración: {self.duracion} | "
            f"Estado: {self.estado} | Total: ${self.costo:,.2f}"
        )


# Listas para guardar y buscar los registros.
class SistemaSoftwareFJ:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, cliente):
        if any(item.identificador == cliente.identificador for item in self.clientes):
            raise ErrorValidacion("Ya existe un cliente con ese identificador.")
        self.clientes.append(cliente)
        logging.info("Cliente registrado: %s", cliente.identificador)

    def registrar_servicio(self, servicio):
        if any(item.identificador == servicio.identificador for item in self.servicios):
            raise ErrorValidacion("Ya existe un servicio con ese identificador.")
        self.servicios.append(servicio)
        logging.info("Servicio registrado: %s", servicio.identificador)

    def buscar_cliente(self, identificador):
        for cliente in self.clientes:
            if cliente.identificador == identificador:
                return cliente
        raise ErrorValidacion("No se encontró el cliente.")

    def buscar_servicio(self, identificador):
        for servicio in self.servicios:
            if servicio.identificador == identificador:
                return servicio
        raise ErrorValidacion("No se encontró el servicio.")

    def buscar_reserva(self, identificador):
        for reserva in self.reservas:
            if reserva.identificador == identificador:
                return reserva
        raise ErrorValidacion("No se encontró la reserva.")

    def crear_reserva(self, identificador, id_cliente, id_servicio,
                      duracion, impuesto=0, descuento=0):
        if any(item.identificador == identificador for item in self.reservas):
            raise ErrorValidacion("Ya existe una reserva con ese identificador.")
        cliente = self.buscar_cliente(id_cliente)
        servicio = self.buscar_servicio(id_servicio)
        reserva = Reserva(
            identificador, cliente, servicio, duracion, impuesto, descuento
        )
        self.reservas.append(reserva)
        logging.info("Reserva creada: %s", identificador)
        return reserva

    def cambiar_disponibilidad(self, identificador):
        servicio = self.buscar_servicio(identificador)
        servicio.disponible = not servicio.disponible
        logging.info("Disponibilidad cambiada: %s", identificador)
        return servicio.disponible

    def listar(self, elementos, titulo):
        print(f"\n--- {titulo} ---")
        if not elementos:
            print("No hay registros.")
            return
        for elemento in elementos:
            print(elemento.describir())

# Menú para utilizar el sistema.
def menu(sistema):
    while True:
        print("\n========== SOFTWARE FJ ==========")
        print("1. Registrar cliente")
        print("2. Registrar servicio")
        print("3. Crear reserva")
        print("4. Confirmar reserva")
        print("5. Cancelar reserva")
        print("6. Ver clientes")
        print("7. Ver servicios")
        print("8. Ver reservas")
        print("9. Cambiar disponibilidad de un servicio")
        print("0. Salir")

        try:
            opcion = input("Seleccione una opción: ").strip()

            if opcion == "1":
                cliente = Cliente(
                    input("Identificador: "),
                    input("Nombre: "),
                    input("Correo: "),
                    input("Teléfono: ")
                )
                sistema.registrar_cliente(cliente)
                print("Cliente registrado.")

            elif opcion == "2":
                print("1. Sala  2. Alquiler de equipo  3. Asesoría")
                tipo = input("Tipo de servicio: ").strip()
                identificador = input("Identificador: ")
                nombre = input("Nombre: ")
                tarifa = float(input("Tarifa: "))

                if tipo == "1":
                    servicio = ReservaSala(identificador, nombre, tarifa)
                elif tipo == "2":
                    servicio = AlquilerEquipo(identificador, nombre, tarifa)
                elif tipo == "3":
                    servicio = Asesoria(identificador, nombre, tarifa)
                else:
                    raise ErrorValidacion("Tipo de servicio no válido.")

                sistema.registrar_servicio(servicio)
                print("Servicio registrado.")

            elif opcion == "3":
                identificador = input("Identificador de la reserva: ")
                id_cliente = input("Identificador del cliente: ")
                id_servicio = input("Identificador del servicio: ")
                duracion = float(input("Duración: "))
                impuesto = float(input("Impuesto (0 si no aplica): ") or 0)
                descuento = float(input("Descuento (0 si no aplica): ") or 0)
                reserva = sistema.crear_reserva(
                    identificador, id_cliente, id_servicio,
                    duracion, impuesto, descuento
                )
                print(reserva.describir())

            elif opcion == "4":
                reserva = sistema.buscar_reserva(input("Identificador: "))
                print(reserva.procesar())

            elif opcion == "5":
                reserva = sistema.buscar_reserva(input("Identificador: "))
                reserva.cancelar()
                print("Reserva cancelada.")

            elif opcion == "6":
                sistema.listar(sistema.clientes, "CLIENTES")
            elif opcion == "7":
                sistema.listar(sistema.servicios, "SERVICIOS")
            elif opcion == "8":
                sistema.listar(sistema.reservas, "RESERVAS")
            elif opcion == "9":
                disponible = sistema.cambiar_disponibilidad(input("ID del servicio: "))
                print("Servicio disponible." if disponible else "Servicio no disponible.")
            elif opcion == "0":
                print("Gracias por utilizar Software FJ.")
                break
            else:
                raise ErrorValidacion("Seleccione una opción válida.")

        except ErrorSistema as error:
            print("Error:", error)
            logging.exception("Error controlado en el menú.")
        except ValueError:
            print("Error: debe ingresar un número válido.")
            logging.exception("Dato numérico no válido.")
        except KeyboardInterrupt:
            print("\nPrograma cerrado por el usuario.")
            logging.warning("Interrupción del usuario.")
            break
        except Exception:
            print("Ocurrió un error. El programa continuará.")
            logging.exception("Error inesperado en el menú.")


# Inicio del programa.
def main():
    sistema = SistemaSoftwareFJ()
    logging.info("Inicio de Software FJ.")
    try:
        menu(sistema)
    finally:
        logging.info("Fin de Software FJ.")
        print("Registro guardado en software_fj.log.")


if __name__ == "__main__":
    main()
