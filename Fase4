# Herramientas para crear las clases y guardar los errores.
from abc import ABC, abstractmethod
import logging


# Aquí se guardan los eventos y errores del programa.
logging.basicConfig(
    filename="software_fj.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    encoding="utf-8"
)


# Errores que puede presentar el sistema.
class ErrorSistema(Exception):
    pass


class ErrorValidacion(ErrorSistema):
    pass


class ErrorServicio(ErrorSistema):
    pass


class ErrorReserva(ErrorSistema):
    pass


# Clase base para los elementos del sistema.
class Entidad(ABC):
    def __init__(self, identificador):
        if not identificador or not str(identificador).strip():
            raise ErrorValidacion("El identificador es obligatorio.")
        self._identificador = str(identificador).strip()

    @property
    def identificador(self):
        return self._identificador

    @abstractmethod
    def describir(self):
        pass


# Datos del cliente y sus validaciones.
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        self.nombre = nombre
        self.correo = correo
        self.telefono = telefono

    @property
    def nombre(self):
        return self._nombre

    @nombre.setter
    def nombre(self, valor):
        if not isinstance(valor, str) or len(valor.strip()) < 2:
            raise ErrorValidacion("El nombre debe tener al menos 2 caracteres.")
        self._nombre = valor.strip()

    @property
    def correo(self):
        return self._correo

    @correo.setter
    def correo(self, valor):
        if not isinstance(valor, str) or "@" not in valor or "." not in valor:
            raise ErrorValidacion("El correo no es válido.")
        self._correo = valor.strip()

    @property
    def telefono(self):
        return self._telefono

    @telefono.setter
    def telefono(self, valor):
        texto = str(valor).replace(" ", "").replace("+", "").replace("-", "")
        if not texto.isdigit() or len(texto) < 7 or len(texto) > 15:
            raise ErrorValidacion("El teléfono debe tener entre 7 y 15 dígitos.")
        self._telefono = str(valor).strip()

    def describir(self):
        return f"{self.identificador} | {self.nombre} | {self.correo} | {self.telefono}"

# Clase base para los servicios.
class Servicio(Entidad, ABC):
    def __init__(self, identificador, nombre, tarifa, disponible=True):
        super().__init__(identificador)
        if not nombre or not str(nombre).strip():
            raise ErrorValidacion("El nombre del servicio es obligatorio.")
        if not isinstance(tarifa, (int, float)) or isinstance(tarifa, bool) or tarifa <= 0:
            raise ErrorValidacion("La tarifa debe ser mayor que cero.")
        self.nombre = str(nombre).strip()
        self.tarifa = float(tarifa)
        self.disponible = disponible

    def revisar_disponibilidad(self):
        if not self.disponible:
            raise ErrorServicio("El servicio no está disponible.")

    def calcular_total(self, duracion, impuesto=0, descuento=0):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:
            raise ErrorValidacion("La duración debe ser mayor que cero.")
        if not 0 <= impuesto <= 100:
            raise ErrorValidacion("El impuesto debe estar entre 0 y 100.")
        if not 0 <= descuento <= 100:
            raise ErrorValidacion("El descuento debe estar entre 0 y 100.")

        total = self.tarifa * duracion
        total = total + (total * impuesto / 100)
        total = total - (total * descuento / 100)
        return round(total, 2)

    @abstractmethod
    def validar_duracion(self, duracion):
        pass

    @abstractmethod
    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        pass

    @abstractmethod
    def describir(self):
        pass


# Tipos de servicio que ofrece la empresa.
class ReservaSala(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 0 < duracion <= 12:
            raise ErrorValidacion("La sala se reserva por un máximo de 12 horas.")

    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):
        self.validar_duracion(duracion)
        return self.calcular_total(duracion, impuesto, descuento)

    def describir(self):
        return f"Sala: {self.nombre} | Tarifa por hora: ${self.tarifa:,.2f}"


class AlquilerEquipo(Servicio):
    def validar_duracion(self, duracion):
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or not 0 < duracion <= 30:
